# Battlefield destruction
dh-poi-object-broken = { $object } is knocked out!
dh-poi-object-broken-announce = Objective asset knocked out: { $object }. It stays down until repaired.
dh-poi-object-contamination = A power plant reactor is destroyed — radiation leak! The area around the plant is contaminated; NBC suits needed.
dh-poi-object-need-material = Repairs need { $amount } { $material } in your other hand.
dh-poi-object-repaired = { $object } is back in action.
dh-poi-object-examine-broken = [color=#e8604a]Knocked out.[/color] Repair with a welder: { $amount } { $material } in your other hand.
dh-poi-material-steel = steel sheets
dh-poi-material-plasteel = plasteel sheets
dh-heavy-gun-broken = The gun is knocked out: repair it first.

dh-bridge-collapsed = A bridge span collapses into the water!
dh-pontoon-no-bridge = There is no collapsed bridge span nearby.
dh-pontoon-deploying = Deploying the pontoon...
dh-pontoon-deployed = Pontoon deployed: the span can be crossed again.

dh-rubble-buried = You are buried under the rubble!
dh-rubble-clearing = Clearing the rubble...
dh-rubble-freed = You are out from under the rubble.
