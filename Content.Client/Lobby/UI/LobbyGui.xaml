<!-- DarkestHour: лобби «Осады» (план п. 23, решения автора 2026-11-20): чата и правой панели нет, справа — «личное
     дело» персонажа в стиле терминала (LobbyCharacterPreviewPanel), поверх всего экрана — шейдер старого монитора
     (DHCrtOverlay). Имена контролов, на которые ссылается остальной код (ServerName, StationTime, ServerInfo,
     RightSide, AHelpButton, VoteContainer…), сохранены. -->
<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:dhui="clr-namespace:Content.Client._DarkestHour.UI">
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="16 16 16 16" SeparationOverride="16">
        <!-- LHS Controls -->
        <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
            <Control Name="DefaultState" VerticalExpand="True">
                <BoxContainer Name="TopLeft" Orientation="Vertical" SeparationOverride="10" MaxWidth="660"
                              HorizontalAlignment="Left">
                    <!-- Заголовок, «Наблюдать», таймер, «Готов» -->
                    <PanelContainer Name="LeftSideTop">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0E0B07DB" BorderColor="#5A4120" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="16 12 16 14" SeparationOverride="10">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                                <Label Name="ServerName" Access="Public" StyleClasses="LabelHeadingBigger"
                                       FontColorOverride="#E3A440" HorizontalExpand="True" VAlign="Center" />
                                <Label Name="StationTime" Access="Public" FontColorOverride="#9C7A45"
                                       VAlign="Center" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                                <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                    Text="{Loc 'ui-lobby-observe-button'}"
                                                    StyleClasses="ButtonBig" MinSize="0 48"
                                                    WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                <Label Name="StartTime"
                                       Access="Public"
                                       Align="Left"
                                       FontColorOverride="#E8E2D4"
                                       StyleClasses="LabelBig" HorizontalExpand="True" />
                                <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                        Text="{Loc 'ui-lobby-ready-up-button'}"
                                        StyleClasses="ButtonBig" MinSize="160 48" />
                            </BoxContainer>
                            <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" HorizontalAlignment="Center" />
                            <info:LinkBanner Name="LinkBanner" VerticalExpand="false" HorizontalAlignment="Left" />
                        </BoxContainer>
                    </PanelContainer>
                    <!-- Голосования (за карту и режим — автоматически при входе в лобби) -->
                    <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                  Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </BoxContainer>
                <!-- Низ слева: кнопки и сведения о музыке и фоне -->
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              SeparationOverride="6">
                    <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="false" />
                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0E0B07C0" BorderColor="#5A4120" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8 6 8 6">
                            <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Left" />
                            <RichTextLabel Name="LobbyBackground" Access="Public" HorizontalAlignment="Left" />
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                StyleClasses="ButtonBig" MinSize="0 44" />
                        <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="ButtonBig" MinSize="0 44" />
                        <Button Name="OptionsButton" Access="Public" StyleClasses="ButtonBig" MinSize="0 44"
                                Text="{Loc 'ui-lobby-options-button'}" />
                        <Button Name="LeaveButton" Access="Public" StyleClasses="ButtonBig" MinSize="0 44"
                                Text="{Loc 'ui-lobby-leave-button'}" />
                    </BoxContainer>
                </BoxContainer>
            </Control>
            <!-- Character setup state -->
            <!-- This is injected on startup. Funky! -->
            <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
        </BoxContainer>
        <!-- Справа — личное дело персонажа -->
        <PanelContainer Name="RightSide" Access="Public" HorizontalAlignment="Right" VerticalExpand="True"
                        VerticalAlignment="Stretch">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#0B0A07F2" BorderColor="#5A4120" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="22 18 22 18">
                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" VerticalExpand="True" />
                <!-- Текст о сервере (welcome) — не показывается, но его по-прежнему обновляет LobbyState. -->
                <info:ServerInfo Name="ServerInfo" Access="Public" Visible="False" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <!-- Старый монитор поверх всего лобби -->
    <dhui:DHCrtOverlay Name="CrtOverlay" />
</lobbyUi:LobbyGui>
