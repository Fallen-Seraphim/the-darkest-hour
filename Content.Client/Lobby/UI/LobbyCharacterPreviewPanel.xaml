<!-- DarkestHour: «личное дело» персонажа в лобби «Осады» (план п. 23, решения автора 2026-11-20): терминальный янтарный
     стиль, персонаж в снаряжении должности с высоким приоритетом, стрелки листают сохранённых персонажей, сводка по
     должностям обеих сторон, любимым отрядам, месту рождения и наигранному времени. -->
<Control
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls">
    <BoxContainer Name="VBox" Orientation="Vertical" SeparationOverride="12" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal">
            <Label Name="Header" Text="{Loc 'dh-lobby-file-header'}" FontColorOverride="#E3A440"
                   StyleClasses="LabelBig" HorizontalExpand="True" />
            <Label Name="FileNumber" FontColorOverride="#9C7A45" VAlign="Center" />
        </BoxContainer>
        <PanelContainer MinSize="0 1">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#5A4120" />
            </PanelContainer.PanelOverride>
        </PanelContainer>
        <BoxContainer Name="Loaded" Orientation="Vertical" Visible="False" SeparationOverride="10"
                      VerticalExpand="True">
            <Label Name="Summary" Visible="False" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <Button Name="PrevButton" Access="Public" Text="◀" MinSize="48 48"
                        ToolTip="{Loc 'dh-lobby-file-prev'}" VerticalAlignment="Center" />
                <BoxContainer Name="ViewBox" Orientation="Horizontal" HorizontalExpand="True"
                              HorizontalAlignment="Center" SeparationOverride="24">
                    <profile:ProfilePreviewSpriteView Name="ProfilePreviewSpriteView"
                                                      OverrideDirection="South"
                                                      Scale="5 5"
                                                      MinSize="128 160"
                                                      Stretch="Fill"
                                                      Access="Public" />
                    <SpriteView Name="SidePreview"
                                OverrideDirection="East"
                                Scale="5 5"
                                MinSize="128 160"
                                Stretch="Fill" />
                </BoxContainer>
                <Button Name="NextButton" Access="Public" Text="▶" MinSize="48 48"
                        ToolTip="{Loc 'dh-lobby-file-next'}" VerticalAlignment="Center" />
            </BoxContainer>
            <Label Name="SlotLabel" FontColorOverride="#9C7A45" HorizontalAlignment="Center" />
            <GridContainer Name="Fields" Columns="2" HorizontalExpand="True" HSeparationOverride="16" VSeparationOverride="6">
                <Label Text="{Loc 'dh-lobby-file-name'}" FontColorOverride="#9C7A45" MinWidth="180" />
                <Label Name="NameValue" FontColorOverride="#F0C470" ClipText="True" HorizontalExpand="True" />
                <Label Text="{Loc 'dh-lobby-file-age'}" FontColorOverride="#9C7A45" />
                <Label Name="AgeValue" FontColorOverride="#E3A440" />
                <Label Text="{Loc 'dh-lobby-file-birthplace'}" FontColorOverride="#9C7A45" />
                <Label Name="BirthplaceValue" FontColorOverride="#E3A440" ClipText="True" HorizontalExpand="True" />
                <Label Text="{Loc 'dh-lobby-file-empire'}" FontColorOverride="#9C7A45" />
                <Label Name="EmpireValue" FontColorOverride="#F2C230" ClipText="True" HorizontalExpand="True" />
                <Label Text="{Loc 'dh-lobby-file-republic'}" FontColorOverride="#9C7A45" />
                <Label Name="RepublicValue" FontColorOverride="#7FAE46" ClipText="True" HorizontalExpand="True" />
                <Label Text="{Loc 'dh-lobby-file-squads'}" FontColorOverride="#9C7A45" />
                <Label Name="SquadsValue" FontColorOverride="#E3A440" ClipText="True" HorizontalExpand="True" />
                <Label Text="{Loc 'dh-lobby-file-playtime'}" FontColorOverride="#9C7A45" />
                <Label Name="PlaytimeValue" FontColorOverride="#E3A440" />
            </GridContainer>
            <Control VerticalExpand="True" />
            <Button Name="CharacterSetup" Text="{Loc 'dh-lobby-file-edit'}" MinSize="0 48" />
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"
               FontColorOverride="#9C7A45" />
        <Label Name="Footer" FontColorOverride="#7A6238" />
    </BoxContainer>
</Control>
